# Public configuration only. Do not put secrets in this file or in source.
# Copy to the host environment if you need to override the defaults.
# Never commit a filled .env.

# HTTPS URL of the rental health JSON. Default is the public o7 host.
RENTAL_HEALTH_URL=https://cherry-rental-engine-o7.vercel.app/api/health

# Abort the health read and each host probe after this many milliseconds.
HEALTH_TIMEOUT_MS=4000
